# REQUIRED
JWT_SECRET=change-me-to-a-long-random-string-32+chars
MONGO_URI=mongodb://127.0.0.1:27017/inventory      # use a replica set / Atlas to get real multi-document transactions
# OPTIONAL
PORT=5000
NODE_ENV=production
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=10
CORS_ORIGINS=https://your-frontend.example.com      # comma separated; empty = same-origin/dev only
SERVE_LEGACY=true                                    # serve the old compiled UI from ../legacy-ui
LOGIN_RATE_LIMIT=30                                  # per 15 min per IP
RATE_LIMIT=900                                       # per minute per IP
SEED_DEMO_PASSWORD=                                  # dev seed only
BOOTSTRAP_ADMIN_EMAIL=                               # first admin, created only when the users table is empty
BOOTSTRAP_ADMIN_PASSWORD=                            # min 8 chars
SEED_ON_START=false                                  # true = create demo locations/parts/BOMs/vehicles at boot
SEED_DEMO_USERS=true                                 # false = no demo users
